# Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# Database (Home Server MongoDB)
MONGO_URI="mongodb://192.168.0.6:27017/mubarak_db"

# Security Secrets
JWT_ACCESS_SECRET="dev_access_secret_change_in_production"
JWT_REFRESH_SECRET="dev_refresh_secret_change_in_production"

# Cloudinary (Images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Firebase Admin SDK (for backend token verification)
# Paste your Firebase service account JSON as a single-line string
# Example: FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project",...}'
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Google Places API (for location autocomplete)
GOOGLE_PLACES_API_KEY=""

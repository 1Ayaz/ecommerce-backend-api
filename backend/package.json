{
    "name": "mubarak-backend",
    "version": "1.0.0",
    "description": "Mubarak Fresh Chicken - Quick Commerce Backend",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "seed": "node seeder.js",
        "test": "jest --coverage --detectOpenHandles",
        "test:watch": "jest --watch"
    },
    "keywords": [
        "quick-commerce",
        "mern",
        "chicken-delivery"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-async-handler": "^1.2.0",
        "express-validator": "^7.3.1",
        "firebase-admin": "^12.0.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.0",
        "morgan": "^1.10.0"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.0.1",
        "supertest": "^6.3.3"
    },
    "jest": {
        "testEnvironment": "node",
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ],
        "testMatch": [
            "**/tests/**/*.test.js"
        ]
    }
}

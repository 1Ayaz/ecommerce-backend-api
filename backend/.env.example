# Environment Variables for Backend
# Copy this to .env and fill in values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/mubarak_db
MONGO_URI_TEST=mongodb://localhost:27017/mubarak_test

# JWT Secrets (generate unique random strings)
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# CORS — Allowed frontend origins (comma-separated for multiple)
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK — entire service account JSON, stringified
# Get from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Google Places API Key (server-side geocoding/distance)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Site URL (used for sitemap generation)
SITE_URL=http://localhost:5173

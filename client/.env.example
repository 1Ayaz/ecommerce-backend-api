# Environment Variables for Client
# Copy this to .env and fill in values

# Backend API URL (must include /api path; e.g. http://localhost:5000/api or https://your-render-domain.onrender.com/api)
VITE_API_URL=http://localhost:5000/api

# Socket.IO URL (backend root URL without /api)
VITE_SOCKET_URL=http://localhost:5000

# Site URL for SEO/JSON-LD (your production frontend domain)
VITE_SITE_URL=http://localhost:5173

# Firebase Client Configuration (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Places API Key (for store location autocomplete)
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Web Push VAPID Public Key (from Firebase Console > Cloud Messaging > Web Push certificates)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

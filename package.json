{
  "name": "the-fresh-cuts",
  "version": "1.0.0",
  "description": "The Fresh Cuts Backend & Quick Commerce",
  "scripts": {
    "postinstall": "npm install --prefix backend",
    "server": "npm run dev --prefix backend",
